# ---- Tavus (avatar conversacional en tiempo real) ----
# https://platform.tavus.io  ->  API Keys
# OJO: el plan gratuito trae ~25 minutos de conversacion AL MES. Se gastan rapido.
TAVUS_API_KEY=

# ---- ElevenLabs (voz espanola del profe) ----
# https://elevenlabs.io  ->  Profile  ->  API Key
ELEVENLABS_API_KEY=

# ---- Persona: el "cerebro + voz" del profe ----
# Creala TU con:  npm run persona
# Ese comando te devuelve un persona_id. Pegalo aqui.
TAVUS_PERSONA_ID=

# ---- Replica: la cara del avatar ----
# rfe12d8b9597 = "Nathan - Bookshelf", una replica de stock de Tavus (un profe en su estudio).
# Funciona tal cual. Cambiala si quieres otra cara o si clonas la tuya.
TAVUS_REPLICA_ID=rfe12d8b9597

# ---- Voz de ElevenLabs ----
# RxPoOxDaJiOdJGnMMaql = "Javier Rojas - Calm & Friendly" (espanol).
# Lista las tuyas con el servidor arrancado: curl localhost:4300/api/voices
EL_VOICE_ID=RxPoOxDaJiOdJGnMMaql
